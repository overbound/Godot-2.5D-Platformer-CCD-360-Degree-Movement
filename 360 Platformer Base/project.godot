[layer_names]

3d_render/layer_1="player"
3d_render/layer_2="environment"
3d_render/layer_3="items"
3d_render/layer_4="enemies"
3d_render/layer_5="Enemy Ranges"
3d_physics/layer_1="PlayerHitbox"
3d_physics/layer_2="foreground"
3d_physics/layer_3="foreground_active"
3d_physics/layer_4="itemHitboxes"
3d_physics/layer_5="PlayerAttackHitbox"
3d_physics/layer_6="EnemyHitbox"
3d_physics/layer_7="EnemyAttackHitbox"
3d_physics/layer_8="PlayerHitBoxInteract (Spring)"
3d_physics/layer_9="Crate Pieces"
3d_physics/layer_10="Interactable"
3d_physics/layer_11="EnemyGroundCollisions"
3d_physics/layer_12="OneWayPlatform"
3d_physics/layer_13="Enemy Ranges"
3d_physics/layer_14="HiddenPanel"
3d_physics/layer_15="PlayerStopZone"
3d_physics/layer_17="Z foreground"

[physics]

common/max_physics_steps_per_frame=1

[rendering]

renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
